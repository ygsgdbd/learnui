{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "stripInternal": true
  },
  "include": [
    "src/index.ts",
    "src/styles.ts"
  ],
  "exclude": [
    "**/*.stories.*",
    "**/*.test.*",
    "**/*.spec.*",
    "**/__fixtures__/**",
    "**/__mocks__/**",
    "**/__tests__/**"
  ]
}
