{
  "name": "learnui",
  "version": "0.0.0",
  "private": true,
  "description": "A learning monorepo for accessible Web and React Native components.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "storybook": "pnpm --filter @learnui/web storybook",
    "storybook:build": "pnpm --filter @learnui/web build-storybook",
    "native": "pnpm --filter @learnui/native start"
  }
}
